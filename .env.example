# Copy to .env and adjust. The CLI reads the flat variables directly.
# The M2 pydantic-settings config accepts both flat and nested YUANTA_* variables.
YUANTA_ENV=UAT
YUANTA_SPARK_API_DIR=vendor/yuanta/sparkapi
YUANTA_ACCOUNT=S98875005091
YUANTA_PASSWORD=1234
# macOS/Linux login needs a Pfx credential:
# YUANTA_PFX_PATH=/absolute/path/to/cert.pfx
# YUANTA_PFX_PASS=yuanta
YUANTA_LOGIN_TIMEOUT=15

# M2 service settings (nested form, overrides TOML)
YUANTA_SERVER__HOST=127.0.0.1
YUANTA_SERVER__PORT=8000
YUANTA_SERVER__API_TOKEN=
YUANTA_SERVER__LOG_LEVEL=INFO
YUANTA_SERVER__LOG_JSON=true
